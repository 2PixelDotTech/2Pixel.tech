# Local secrets for `npm run dev`. Copy to .dev.vars (git-ignored).
# These are Cloudflare's public Turnstile TEST keys: they always pass and are safe to share.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: a real Resend key to test sending email locally. Leave empty to skip email.
RESEND_API_KEY=
